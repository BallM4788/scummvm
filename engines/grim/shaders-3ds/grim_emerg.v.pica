; emergency text shader for Grim Fandango and Escape from Monkey Island in SCUMMVM

; ORIGINAL GLSL CODE
;	in vec2 position;
;	in vec2 texcoord;
;
;	uniform vec2 sizeWH;
;	uniform vec2 offsetXY;
;
;	uniform vec2 texOffsetXY;
;	uniform vec2 texScale;
;
;	out vec2 Texcoord;
;
;	void main() {
;		vec2 tex = texcoord;
;		tex.y = 1.0 - tex.y;
;		tex *= texScale;
;		Texcoord = texOffsetXY + tex;
;		vec2 pos = offsetXY + position * sizeWH;
;		pos.x = pos.x * 2.0 - 1.0;
;		pos.y = -1.0 * (pos.y * 2.0 - 1.0);
;		gl_Position = vec4(pos, 0.0, 1.0);
;	}

; ORIGINAL GLSL FRAGMENT SHADER CODE
;	in vec2 Texcoord;
;
;	OUTPUT
;
;	uniform sampler2D tex;
;	uniform vec3 color;
;
;	void main() {
;		outColor = vec4(color, texture(tex, Texcoord).a);
;	}

; NOTES
;	- Since the 3DS doesn't support custom fragment shaders,
;		we're assigning the Alpha component via the texture environment.


; Constants
.constf myConst(0.0, 1.0, 2.0, 0.5)
.alias ZEROS		 myConst.xxxx
.alias ONES			 myConst.yyyy
.alias TWOS			 myConst.zzzz
.alias HALF			 myConst.wwww
.alias NEGONES		-myConst.yyyy


; Inputs
.alias inPos		v0		; in vec2 position
.alias inTcoord		v1		; in vec2 texcoord


; Uniforms
.fvec sizeTexScale		; vec2 sizeWH + vec2 texScale
.fvec offsetTexOffset	; vec2 offsetXY + vec2 texOffsetXY
.fvec color				; vec3 color
.alias sizeWH		sizeTexScale.xy
.alias texScale		sizeTexScale.zw
.alias offsetXY		offsetTexOffset.xy
.alias texOffsetXY	offsetTexOffset.zw


; Outputs
.out outPos			pos		; gl_Position
.out outTcoord		tcoord0	; out vec2 Texcoord
.out outColor		clr		; outColor


; Main
.entry main
.proc main
	mov r0.xy,			inTcoord
	mov r1.y,			NEGONES
	mad r0.y,			r0.y,				r1.y,				ONES
	mul r0.xy,			texScale,			r0.xy
	add outTcoord,		texOffsetXY,		r0.xy

	mov r1.xy,			offsetXY
	mad r0.xy,			inPos.xy,			sizeWH,				r1.xy
	mov r1.xy,			TWOS
	mad r0.xy,			r0.xy,				r1.xy,				NEGONES
	; Do NOT flip Y-sign. Because we're drawing to a texture, we want the Y coordinate to remain flipped.
	mov outPos.xy,		r0.xy
	; 3DS system clips z component of window coordinates in the range [0, -1] instead of [-1, 1]
	; z-component 0.0 in openGL -> -0.5 in 3DS
	mov outPos.z,		-HALF
	mov outPos.w,		 ONES

	mov outColor,		 color.rgb

	end
.end
