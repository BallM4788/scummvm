; dimming shader for Grim Fandango in SCUMMVM

; ORIGINAL GLSL CODE
;	in vec2 position;
;	in vec2 texcoord;
;
;	uniform vec2 scaleWH;
;
;	out vec2 Texcoord;
;
;	void main() {
;		Texcoord = texcoord;
;		// Coordinates are [0.0;1.0], transform to [-1.0; 1.0]
;		vec2 pos = position * scaleWH;
;		pos.x = pos.x * 2.0 - 1.0;
;		pos.y = pos.y * 2.0 - 1.0;
;
;		gl_Position = vec4(pos, 0.0, 1.0);
;	}

; FRAGMENT SHADER CODE
;	in vec2 Texcoord;
;
;	OUTPUT
;
;	uniform sampler2D tex;
;	// DimScreen: 1, 1. DimRegion (blended): 0, 1 - level
;	uniform float colorScale;
;	uniform float alpha;
;
;	void main() {
;		vec4 c = texture(tex, Texcoord);
;		float grey = max(max(c.r, c.g), c.b / 8.0) / 4.0;
;		outColor = vec4(vec3(grey * colorScale), alpha);
;	}


; NOTES
;	- The 3DS does not support custom fragment shaders, so we
;		do the dimming with a texture environment.


; Constants
.constf myConst(0.1, 1.0, 2.0, 0.5)
.alias DIVTEN		 myConst.xxxx
.alias ONES			 myConst.yyyy
.alias TWOS			 myConst.zzzz
.alias HALF			 myConst.wwww
.alias NEGONES		-myConst.yyyy


; Inputs
.alias    inPos		v0		; in vec2 position


; Uniforms

.fvec combinedUnif			; vec4(scaleW, scaleH, colorScale, alpha)


; Outputs
.out outPos			pos		; gl_Position
.out outColor		clr		; output 0.1 in RGB components for dimming


; Main
.entry main
.proc main
	mul r0.xy,			 combinedUnif.xy,		inPos.xy
	mov r1.xy,			 TWOS
	; Do NOT flip Y-sign
	mad outPos.xy,		 r0.xy,				r1.xy,				NEGONES
	; 3DS system clips z component of window coordinates in the range [0, -1] instead of [-1, 1]
	; z-component 0.0 in openGL -> -1.0 in 3DS
	mov outPos.z,		 NEGONES
	mov outPos.w,		 ONES

	mov outColor.rgb,	 combinedUnif.z
	mov outColor.a,		 combinedUnif.w
	end
.end
