; actor shader for Escape from Monkey Island in SCUMMVM

; ORIGINAL GLSL VERTEX SHADER CODE
;	in vec3 position;
;	in vec2 texcoord;
;	in vec4 color;
;	in vec3 normal;
;
;	uniform highp mat4 modelMatrix;
;	uniform highp mat4 viewMatrix;
;	uniform highp mat4 projMatrix;
;	uniform highp mat4 extraMatrix;
;	uniform highp mat4 normalMatrix;
;	uniform highp vec3 cameraPos;
;	uniform UBOOL textured;
;	uniform UBOOL useVertexAlpha;
;	uniform vec4 uniformColor;
;
;	struct shadow_info {
;		UBOOL _active;
;		vec3 _color;
;		vec3 _light;
;		vec3 _point;
;		vec3 _normal;
;	};
;
;	uniform shadow_info shadow;
;
;	out vec2 Texcoord;
;	out vec4 Color;
;
;	void main() {
;		vec4 pos = vec4(position, 1.0);
;		pos = modelMatrix * pos;
;
;		// See http://en.wikipedia.org/wiki/Line-plane_intersection
;		if (UBOOL_TEST(shadow._active)) {
;			pos /= pos.w;
;			vec3 l = pos.xyz - shadow._light;
;			float d = dot(shadow._point - shadow._light, shadow._normal) / dot(l, shadow._normal);
;			vec3 p = shadow._light + d * l;
;			pos = vec4(p, 1.0);
;		}
;
;		pos -= vec4(cameraPos * pos.w, 0.0);
;		pos = viewMatrix * pos;
;		pos /= pos.w;
;		pos.z *= -1.0;
;
;		vec4 projectedPos = projMatrix * pos;
;
;		gl_Position = projectedPos;
;
;		if (UBOOL_TEST(shadow._active)) {
;			Color = vec4(shadow._color, 1.0);
;		} else {
;			Color = color;
;		}
;		if (!UBOOL_TEST(useVertexAlpha))
;			Color.a = 1.0;
;		Color *= uniformColor;
;		if (UBOOL_TEST(textured)) {
;			Texcoord = texcoord;
;		} else {
;			Texcoord = vec2(0.0, 0.0);
;		}
;	}

; ORIGINAL GLSL FRAGMENT SHADER CODE
;	in vec2 Texcoord;
;	in vec4 Color;
;
;	uniform sampler2D tex;
;	uniform UBOOL textured;
;	uniform float alphaRef;
;	uniform float meshAlpha;
;
;	OUTPUT
;
;	void main() {
;		outColor = Color;
;		if (UBOOL_TEST(textured)) {
;			vec4 texColor = texture(tex, Texcoord);
;			outColor.rgba *= texColor.rgba;
;			outColor.a *= meshAlpha;
;			if (outColor.a < alphaRef)
;				discard;
;		}
;	}

; NOTES:


; Constants
.constf myConst(0.0, 1.0, 2.0, 0.5)
.alias       ZEROS	 myConst.xxxx
.alias        ONES	 myConst.yyyy
.alias     NEGONES	-myConst.yyyy
.alias    ZERO_ONE	 myConst.xyxy
.constf myConst2(1 / 16777215.0, 16777215.0, 0.0, 0.0)
.alias     EPSILON	 myConst2.xxxx
.alias EPSILON_RCP	 myConst2.yyyy

; end index = 7, start index = 0, step = 1 (loops 8 times)
.consti	loopParams(7, 0, 1, 0)


; Inputs
.alias    inPos		v0		; in vec3 position
.alias inTcoord		v1		; in vec2 texcoord
.alias  inColor		v2		; in vec4 color
.alias inNormal		v3		; in vec3 normal
; TODO: CREATE INPUT FOR LOCAL ALPHA


; Uniforms
.fvec  modelMatrix[4]		; mat4  modelMatrix
.fvec   viewMatrix[4]		; mat4   viewMatrix
.fvec   projMatrix[4]		; mat4   projMatrix
.fvec      projFix[4]
												;.fvec  extraMatrix[4]		; mat4  extraMatrix
.fvec normalMatrix[4]		; mat4 normalMatrix
.fvec    cameraPos			; vec3    cameraPos
.fvec uniformColor			; vec4 uniformColor

.bool    textured			; UBOOL textured
.bool    notVtxAlpha		; UBOOL !useVertexAlpha

.bool shadowActive		; UBOOL shadow._active
.fvec shadowColor		;  vec3 shadow._color
.fvec shadowLight		;  vec3 shadow._light
.fvec shadowPoint		;  vec3 shadow._point
.fvec shadowNormal		;  vec3 shadow._normal


; Outputs
.out outPos		pos		; gl_Position
.out outTcoord	tcoord0	; out vec2 Texcoord
.out outColor	clr		; out vec4 Color


; Register Aliases
.alias TMP_0			r0
.alias TMP_1			r1
.alias TMP_2			r2
.alias vec4_pos			r3		;  vec4 pos																		THIS IS KEPT, UNLIKE IN GRIM FANDANGO
.alias vec3_shPnt		r4.xyz	;  vec3 shadowPoint, moved to temp register
.alias vec3_shNrm		r5.xyz	;  vec3 shadowNormal, moved to temp register
.alias vec3_shLgt		r6.xyz	;  vec3 shadowLight, moved to temp register
.alias dp3_NrmPos		r7.x
.alias dp3_NrmPnt		r7.y
.alias dp3_NrmLgt		r7.z
.alias tmpColor			r4		; Since each output register component must be written to EXACTLY ONCE,
								;	modify the output color here before writing to outColor.


; Main
.entry main
.proc main
	; TMP_0 = vec4(inPos, 1.0);
	mov TMP_0.xyz,		inPos.xyz
	mov TMP_0.w,		ONES

	; vec4_pos = modelMatrix * TMP_0;
	dp4 vec4_pos.x,		modelMatrix[0],		TMP_0
	dp4 vec4_pos.y,		modelMatrix[1],		TMP_0
	dp4 vec4_pos.z,		modelMatrix[2],		TMP_0
	dp4 vec4_pos.w,		modelMatrix[3],		TMP_0

; TMP_0:     UNOCCUPIED
; TMP_1:     UNOCCUPIED
; TMP_2:     UNOCCUPIED
; vec4_pos:    OCCUPIED (r3)
; outPos:     UNWRITTEN
; outTcoord:  UNWRITTEN
; outColor:   UNWRITTEN

	; if (shadowActive)
	ifu shadowActive
		; The line-plane intersection implementation used in
		;	the GLSL shader does not work here. It seems that
		;	the position vector being divided by the w component
		;	before doing shadow calculations causes the final
		;	vector position to go wild. Eliminating the w division
		;	fixed it, but the shadows were very choppy.
		; Instead, we're taking the shadow projection function
		;	used in the OpenGL renderer and implementing its
		;	matrix calculations through shader operations. It
		;	-would- be simpler to just create a shadow matrix
		;	in software and pass it to the shader, but for some
		;	reason doing that introduces crashes in various
		;	locations.
		mov vec3_shNrm,		shadowNormal.xyz									; vec3_shNrm   = shadowNormal(xyz)
		mov vec3_shPnt,		shadowPoint.xyz										; vec3_shPnt   = shadowPoint(xyz)
		mov vec3_shLgt,		shadowLight.xyz										; vec3_shLgt   = shadowLight(xyz)

		dp3 dp3_NrmPnt,		vec3_shNrm,			vec3_shPnt						; dp3(vec3_shNrm, vec3_shPnt)
		dp3 dp3_NrmLgt,		vec3_shNrm,			vec3_shLgt						; dp3(vec3_shNrm, vec3_shLgt)
		dp3 dp3_NrmPos,		vec3_shNrm,			vec4_pos						; dp3(vec3_shNrm, VtxPos.xyz)

		add TMP_0.y,		dp3_NrmPnt,			-dp3_NrmLgt						; dp3_NrmPnt - dp3_NrmLgt
		mad TMP_0.x,		dp3_NrmPnt,			-vec4_pos.w,		dp3_NrmPos	; dp3_NrmPos - (dp3_NrmPnt * VtxPos.w)
		mad TMP_0.z,		dp3_NrmLgt,			-vec4_pos.w,		dp3_NrmPos	; dp3_NrmPos - (dp3_NrmLgt * VtxPos.w)

		mul TMP_1.xyz,		vec3_shLgt,			TMP_0.x							; vec3_shLgt * (dp3_NrmPos - (dp3_NrmPnt * VtxPos.w))
		mul TMP_2.xyz,		vec4_pos.xyz,		TMP_0.y							; vec4_pos.xyz * (dp3_NrmPnt - dp3_NrmLgt)

		mov vec4_pos.w,		TMP_0.z												; pos.w = dp3_NrmPos - (dp3_NrmLgt * VtxPos.w)
		add vec4_pos.xyz,	TMP_1.xyz,			TMP_2.xyz						; pos.xyz = vec3_shLgt (dp3_NrmPos - (VtxPos.w * dp3_NrmPnt)) + VtxPos.xyz (dp3_NrmPnt - dp3_NrmLgt)
	.end

	; TMP_1 = vec4_pos - vec4(cameraPos * vec4_pos.w, 0.0);
	mov TMP_0.w,		ZEROS
	mul TMP_0.xyz,		cameraPos.xyz,		 vec4_pos.w
	add TMP_1,			vec4_pos,			-TMP_0

	; TMP_0 = viewMatrix * TMP_1;
	dp4 TMP_0.x,		viewMatrix[0],		TMP_1
	dp4 TMP_0.y,		viewMatrix[1],		TMP_1
	dp4 TMP_0.z,		viewMatrix[2],		TMP_1
	dp4 TMP_0.w,		viewMatrix[3],		TMP_1

	; vec4_pos = TMP_0 / TMP_0.w;
	rcp TMP_1,			TMP_0.w
	mul vec4_pos,		TMP_0,				TMP_1

	; vec4_pos.z *= -1.0;
	mul vec4_pos.z,		NEGONES,			vec4_pos.z

	; r10 = projMatrix * vec4_pos;
	dp4 r10.x,			projMatrix[0],		vec4_pos
	dp4 r10.y,			projMatrix[1],		vec4_pos
	dp4 r10.z,			projMatrix[2],		vec4_pos
	dp4 r10.w,			projMatrix[3],		vec4_pos

	; Fix projection for 3DS depth range of [-1, 0], and flip Y coordinate.
	dp4 r11.x,			projFix[0],			r10
	dp4 r11.y,			projFix[1],			r10
	dp4 r11.z,			projFix[2],			r10
	dp4 r11.w,			projFix[3],			r10

	; Before perspective division, compare value in r12.w to zero.
	cmp ZEROS,			lt, gt,				r11.w
	ifc cmp.x																	; If w component is positive...
		rcp r12.w,			r11.w												; ...just get the reciprocal.
	.else
		ifc cmp.y																; If w component is negative...
			rcp r12.w,			-r11.w											; ...get the negative of the reciprocal, to preserve xyz signage.
		.else
			mov r11.w,			EPSILON											; w is zero, change it to 1 / 0xffffff.
			mov r12.w,			EPSILON_RCP										; get 16777215 (reciprocal of smallest non-zero 24-bit depth value).
		.end
	nop																			; .end can't be called consecutively - insert nop instruction between.
	.end

	; Perspective division.
	mul outPos,			r11,				r12.w								; vec4_pos STILL NEEDED

; TMP_0:        UNOCCUPIED
; TMP_1:        UNOCCUPIED
; TMP_2:        UNOCCUPIED
; vec4_pos:       OCCUPIED (r3)
; outPos:          WRITTEN
; outTcoord:     UNWRITTEN
; outColor:      UNWRITTEN

	; if (shadowActive)
	ifu shadowActive
		; tmpColor.rgb = shadowColor;
		; tmpColor.a = 1.0;
		mov tmpColor.rgb,	shadowColor.rgb
		mov tmpColor.a,		ONES
	.else
		; tmpColor = (1.0, 1.0, 1.0, 1.0);
		mov tmpColor,		ONES
	.end

	; if (textured)
	ifu textured
		; outTcoord = inTcoord;
		mov outTcoord,		inTcoord
	.else
		; outTcoord = vec2(0.0, 0.0)
		mov outTcoord,		ZEROS
	.end

	; if (notVtxAlpha)
	ifu notVtxAlpha
		; tmpColor.a = 1.0;
		mov tmpColor.a,		ONES
	.end

	; tmpColor *= uniformColor;
	mul outColor,		uniformColor,		tmpColor

	end
.end
